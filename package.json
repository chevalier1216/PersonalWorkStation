{
  "name": "personal-workstation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "check:migrations": "node scripts/check-migration-files.mjs",
    "check:migration-history": "node scripts/check-migration-history.mjs",
    "executor:local": "node scripts/local-executor.mjs",
    "worker:github-issue": "node scripts/github-issue-worker.mjs",
    "worker:github-issue:doctor": "node scripts/github-issue-worker.mjs --doctor"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
